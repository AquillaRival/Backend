<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChatModel</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <h3>All Chats</h3>
    <form action="/chats/new" method="GET">
      <button>New Chat</button>
    </form>
    <br />
    <% for(chat of chats) { %>
    <div class="chat">
      <p>
        From :
        <%= chat.from %>
      </p>
      <p>To : <%= chat.to %></p>
      <div class="message">
        <p>
          Message :
          <%= chat.message %>
        </p>
      </div>
      <hr />
    </div>
    <% } %>
  </body>
</html>
