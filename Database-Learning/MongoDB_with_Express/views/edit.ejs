<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Your Chat</title>
  </head>
  <body>
    <h3>Edit your chat</h3>
    <p>From : <%= chat.from %></p>
    <p>To : <%= chat.to %></p>

    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
      <textarea name="newMessage"><%= chat.message %></textarea>
      <br />
      <button>Submit</button>
    </form>
  </body>
</html>
